# Dev environment (same host, isolated from prod)
SPRING_PROFILES_ACTIVE=dev

# MySQL (same instance, different database)
DB_URL=jdbc:mysql://172.16.0.2:3306/bean_pattern_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=dev
DB_PASSWORD=REPLACE_ME

# Redis (建议换成内网 redis 容器/地址；先沿用现状)
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# Base URL used for links returned by backend
APP_BASE_URL=http://106.53.119.137:8082
APP_UPLOAD_DIR=/app/uploads
APP_SEED_ENABLED=false

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=REPLACE_ME

# COS (dev bucket)
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_BUCKET=bean-pattern-dev-1417861640
S3_REGION=ap-guangzhou
S3_PUBLIC_BASE_URL=https://bean-pattern-dev-1417861640.cos.ap-guangzhou.myqcloud.com
S3_PATH_STYLE_ACCESS=false
S3_URL_INCLUDE_BUCKET=false
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
