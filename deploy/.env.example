# ==================== 通用配置 ====================
# 复制此文件为 .env 后填写实际值

# ==================== 数据库 ====================
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/bean_pattern?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# ==================== Redis ====================
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379

# ==================== 应用基础配置 ====================
APP_BASE_URL=https://YOUR_DOMAIN
APP_UPLOAD_DIR=/app/uploads
APP_SEED_ENABLED=false

# ==================== 微信小程序 ====================
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# ==================== 支付 ====================
# 生产环境使用 midas，开发环境使用 mock
PAYMENT_PROVIDER=midas
# 虚拟支付：沙箱开关（生产环境填 false，开发环境填 true）
MIDAS_SANDBOX=false
# 虚拟支付：OfferID（微信 MP 后台 → 虚拟支付 → 基础配置）
MIDAS_OFFER_ID=1450536872
# 虚拟支付：正式环境 AppKey
MIDAS_APP_KEY=O27UJPfCxVmDpQqyypyykzTvTaYSXRYC
# 虚拟支付：沙箱环境 AppKey
MIDAS_SANDBOX_APP_KEY=jJ4HFSs49sIwMr29ki1c0Maktr3dqgjh
# 虚拟支付：发货回调 URL（填写你的服务器 HTTPS 地址）
MIDAS_NOTIFY_URL=https://api.pindo.asia/api/pay/midas/notify
# 虚拟支付：发货回调 Token（与 MP 后台发货推送配置中填的 Token 一致）
MIDAS_NOTIFY_TOKEN=

# ==================== AI 接口（可选）====================
AI_API_URL=
AI_API_KEY=

# ==================== 短信服务（可选）====================
SMS_ENABLED=false
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou

# ==================== 对象存储 S3/COS（可选）====================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ap-guangzhou
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE_ACCESS=false
S3_URL_INCLUDE_BUCKET=false
